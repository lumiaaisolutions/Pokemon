  <library_effects>
    <effect id="sea_mizu1-fx" name="sea_mizu1">
      <profile_COMMON>
        <newparam sid="sea_mizu1-diffuse-surface">
          <surface type="2D">
            <init_from>sea_mizu1-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="sea_mizu1-diffuse-sampler">
          <sampler2D>
            <source>sea_mizu1-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
