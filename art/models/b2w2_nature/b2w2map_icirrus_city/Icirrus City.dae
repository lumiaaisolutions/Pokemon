  <library_effects>
    <effect id="michi_hage-fx" name="michi_hage">
      <profile_COMMON>
        <newparam sid="michi_hage-diffuse-surface">
          <surface type="2D">
            <init_from>michi_hage-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="michi_hage-diffuse-sampler">
          <sampler2D>
            <source>michi_hage-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="michi_hage-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
