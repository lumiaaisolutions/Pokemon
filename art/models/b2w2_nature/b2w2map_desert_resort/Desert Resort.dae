  <library_effects>
    <effect id="gake_futa-fx" name="gake_futa">
      <profile_COMMON>
        <newparam sid="gake_futa-diffuse-surface">
          <surface type="2D">
            <init_from>gake_futa-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="gake_futa-diffuse-sampler">
          <sampler2D>
            <source>gake_futa-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="gake_futa-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
