  <library_effects>
    <effect id="kemono01-fx" name="kemono01">
      <profile_COMMON>
        <newparam sid="kemono01-diffuse-surface">
          <surface type="2D">
            <init_from>kemono01-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="kemono01-diffuse-sampler">
          <sampler2D>
            <source>kemono01-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="kemono01-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
