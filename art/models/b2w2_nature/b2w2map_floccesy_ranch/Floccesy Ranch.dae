    <effect id="michi_hage02-fx" name="michi_hage02">
      <profile_COMMON>
        <newparam sid="michi_hage02-diffuse-surface">
          <surface type="2D">
            <init_from>michi_hage02-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="michi_hage02-diffuse-sampler">
          <sampler2D>
            <source>michi_hage02-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="michi_hage02-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
