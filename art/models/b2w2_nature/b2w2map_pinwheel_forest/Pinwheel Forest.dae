  <library_effects>
    <effect id="c2_road28-fx" name="c2_road28">
      <profile_COMMON>
        <newparam sid="c2_road28-diffuse-surface">
          <surface type="2D">
            <init_from>c2_road28-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="c2_road28-diffuse-sampler">
          <sampler2D>
            <source>c2_road28-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="c2_road28-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
