    <effect id="out25_kusa01-fx" name="out25_kusa01">
      <profile_COMMON>
        <newparam sid="out25_kusa01-diffuse-surface">
          <surface type="2D">
            <init_from>out25_kusa01-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="out25_kusa01-diffuse-sampler">
          <sampler2D>
            <source>out25_kusa01-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="out25_kusa01-diffuse-sampler" texcoord="CHANNEL0" />
