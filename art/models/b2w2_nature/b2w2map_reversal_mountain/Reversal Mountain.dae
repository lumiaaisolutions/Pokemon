  <library_effects>
    <effect id="kusa_ec1s-fx" name="kusa_ec1s">
      <profile_COMMON>
        <newparam sid="kusa_ec1s-diffuse-surface">
          <surface type="2D">
            <init_from>kusa_ec1s-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="kusa_ec1s-diffuse-sampler">
          <sampler2D>
            <source>kusa_ec1s-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="kusa_ec1s-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
