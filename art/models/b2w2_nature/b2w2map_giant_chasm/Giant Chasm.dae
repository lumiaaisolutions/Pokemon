    <effect id="hashi01a-fx" name="hashi01a">
      <profile_COMMON>
        <newparam sid="hashi01a-diffuse-surface">
          <surface type="2D">
            <init_from>hashi01a-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="hashi01a-diffuse-sampler">
          <sampler2D>
