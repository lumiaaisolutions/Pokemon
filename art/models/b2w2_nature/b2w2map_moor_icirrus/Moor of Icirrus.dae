  <library_effects>
    <effect id="mizu_sita2-fx" name="mizu_sita2">
      <profile_COMMON>
        <newparam sid="mizu_sita2-diffuse-surface">
          <surface type="2D">
            <init_from>mizu_sita2-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="mizu_sita2-diffuse-sampler">
          <sampler2D>
            <source>mizu_sita2-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="mizu_sita2-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
