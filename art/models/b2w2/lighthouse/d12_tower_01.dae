          <sampler2D>
            <source>Image-surface</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
            <minfilter>NEAREST</minfilter>
            <magfilter>NEAREST</magfilter>
