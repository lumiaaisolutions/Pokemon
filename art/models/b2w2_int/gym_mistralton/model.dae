    <effect id="gym06_p03-fx" name="gym06_p03">
      <profile_COMMON>
        <newparam sid="gym06_p03-diffuse-surface">
          <surface type="2D">
            <init_from>gym06_p03-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="gym06_p03-diffuse-sampler">
          <sampler2D>
            <source>gym06_p03-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
