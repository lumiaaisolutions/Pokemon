    <effect id="aku_iriguti-fx" name="aku_iriguti">
      <profile_COMMON>
        <newparam sid="aku_iriguti-diffuse-surface">
          <surface type="2D">
            <init_from>aku_iriguti-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="aku_iriguti-diffuse-sampler">
          <sampler2D>
            <source>aku_iriguti-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="aku_iriguti-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
