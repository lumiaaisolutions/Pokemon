  <library_effects>
    <effect id="in05_genkan-fx" name="in05_genkan">
      <profile_COMMON>
        <newparam sid="in05_genkan-diffuse-surface">
          <surface type="2D">
            <init_from>in05_genkan-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in05_genkan-diffuse-sampler">
          <sampler2D>
            <source>in05_genkan-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in05_genkan-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
