  <library_effects>
    <effect id="in70_sea1-fx" name="in70_sea1">
      <profile_COMMON>
        <newparam sid="in70_sea1-diffuse-surface">
          <surface type="2D">
            <init_from>in70_sea1-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in70_sea1-diffuse-sampler">
          <sampler2D>
            <source>in70_sea1-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in70_sea1-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
