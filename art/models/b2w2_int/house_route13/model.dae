  <library_effects>
    <effect id="tg_h03-fx" name="tg_h03">
      <profile_COMMON>
        <newparam sid="tg_h03-diffuse-surface">
          <surface type="2D">
            <init_from>tg_h03-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="tg_h03-diffuse-sampler">
          <sampler2D>
            <source>tg_h03-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="tg_h03-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
