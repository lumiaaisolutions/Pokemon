  <library_effects>
    <effect id="m_h05_mat-fx" name="m_h05_mat">
      <profile_COMMON>
        <newparam sid="m_h05_mat-diffuse-surface">
          <surface type="2D">
            <init_from>m_h05_mat-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="m_h05_mat-diffuse-sampler">
          <sampler2D>
            <source>m_h05_mat-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="m_h05_mat-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
