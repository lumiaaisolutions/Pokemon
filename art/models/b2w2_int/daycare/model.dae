  <library_effects>
    <effect id="in01_cup-fx" name="in01_cup">
      <profile_COMMON>
        <newparam sid="in01_cup-diffuse-surface">
          <surface type="2D">
            <init_from>in01_cup-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in01_cup-diffuse-sampler">
          <sampler2D>
            <source>in01_cup-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in01_cup-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
