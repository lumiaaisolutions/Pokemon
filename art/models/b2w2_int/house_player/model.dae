  <library_effects>
    <effect id="in67_nawa-fx" name="in67_nawa">
      <profile_COMMON>
        <newparam sid="in67_nawa-diffuse-surface">
          <surface type="2D">
            <init_from>in67_nawa-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in67_nawa-diffuse-sampler">
          <sampler2D>
            <source>in67_nawa-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in67_nawa-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
