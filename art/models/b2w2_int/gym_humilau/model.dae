  <library_effects>
    <effect id="in82_plant1-fx" name="in82_plant1">
      <profile_COMMON>
        <newparam sid="in82_plant1-diffuse-surface">
          <surface type="2D">
            <init_from>in82_plant1-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in82_plant1-diffuse-sampler">
          <sampler2D>
            <source>in82_plant1-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in82_plant1-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
