    <effect id="in01_sch_b-fx" name="in01_sch_b">
      <profile_COMMON>
        <newparam sid="in01_sch_b-diffuse-surface">
          <surface type="2D">
            <init_from>in01_sch_b-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in01_sch_b-diffuse-sampler">
          <sampler2D>
            <source>in01_sch_b-diffuse-surface</source>
