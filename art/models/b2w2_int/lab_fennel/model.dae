    <effect id="m_lab01_03-fx" name="m_lab01_03">
      <profile_COMMON>
        <newparam sid="m_lab01_03-diffuse-surface">
          <surface type="2D">
            <init_from>m_lab01_03-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="m_lab01_03-diffuse-sampler">
          <sampler2D>
            <source>m_lab01_03-diffuse-surface</source>
