    <effect id="in45_mat01-fx" name="in45_mat01">
      <profile_COMMON>
        <newparam sid="in45_mat01-diffuse-surface">
          <surface type="2D">
            <init_from>in45_mat01-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in45_mat01-diffuse-sampler">
          <sampler2D>
            <source>in45_mat01-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in45_mat01-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
