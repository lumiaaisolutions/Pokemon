  <library_effects>
    <effect id="in67_bramp-fx" name="in67_bramp">
      <profile_COMMON>
        <newparam sid="in67_bramp-diffuse-surface">
          <surface type="2D">
            <init_from>in67_bramp-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in67_bramp-diffuse-sampler">
          <sampler2D>
            <source>in67_bramp-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in67_bramp-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
